# ---------------------------------------------------------------------------
# SkillBridge backend  -  copy this file to `.env` and fill in the blanks.
# `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
DATABASE_DRIVER=memory
FIREBASE_PROJECT_ID=
FUNCTION_REGION=us-central1

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default college for local in-memory development.
ALLOWED_EMAIL_DOMAIN=apollouniversity.edu.in
COLLEGE_NAME=Apollo University

# How long a one-time password stays valid, in minutes.
OTP_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# Mail  -  how the OTP reaches the student
# ---------------------------------------------------------------------------
# console = print the OTP to this terminal (use this until SMTP is ready)
# smtp    = actually send the email using the SMTP_* values below
MAIL_DRIVER=console
MAIL_FROM="SkillBridge <no-reply@skillbridge.local>"

# Only needed when MAIL_DRIVER=smtp. For Gmail use an App Password,
# not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Firebase / Firestore
# Set DATABASE_DRIVER=firestore and FIREBASE_PROJECT_ID to use Firestore.
# Local development can use the Firebase Emulator Suite:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-skillbridge

# Supabase (optional alternative database)
# ---------------------------------------------------------------------------
# Set DATABASE_DRIVER=supabase to use these credentials.
# The service-role key bypasses RLS - it belongs on the server ONLY,
# never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
