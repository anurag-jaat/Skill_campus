# ---------------------------------------------------------------------------
# SkillBridge frontend  -  copy this file to `.env` and fill in the blanks.
#
# Vite only exposes variables that start with VITE_ to the browser.
# Anything here ends up in the built JavaScript, so NEVER put a secret in
# this file - no service-role keys, no SMTP passwords, no JWT secret.
# ---------------------------------------------------------------------------

# Base URL of the Express API.
#   local  : http://localhost:4000
#   Firebase : https://us-central1-<project-id>.cloudfunctions.net/api
VITE_API_URL=http://localhost:4000

# Use /<github-repository-name>/ for a project GitHub Pages site.
# Use / for a user/org Pages site.
VITE_BASE_PATH=/

# Shown on the login screen so students know which address to use.
# Keep this the same as ALLOWED_EMAIL_DOMAIN in backend/.env.
VITE_COLLEGE_DOMAIN=apollouniversity.edu.in
